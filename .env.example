# Copy this file to .env.local and fill in the values (see docs/SETUP.md).
# .env.local is gitignored. Never put the service role / secret key here.

# Supabase dashboard > Project Settings > Data API (Project URL)
VITE_SUPABASE_URL=

# Supabase dashboard > Project Settings > API Keys: the "publishable" key
# (sb_publishable_...). The legacy "anon" key also works.
VITE_SUPABASE_PUBLISHABLE_KEY=
